# Authentication (REQUIRED) — the app refuses to start without this.
# Clients must send it as the "X-API-Key" header; the web UI prompts for it.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-to-a-long-random-string

# Paperless-NGX
PAPERLESS_URL=http://localhost:8000
PAPERLESS_PUBLIC_URL=http://localhost:8000
PAPERLESS_TOKEN=your_token_here
MAX_RESULTS=20
MAX_SUMMARY=5
# Documents whose passage embeddings stay cached in memory between questions
PASSAGE_CACHE_DOCS=500

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CTX=131072

# Open Notebook (OPTIONAL) — enables "Send to notebook". Leave unset to disable.
# Selected documents' Paperless text is sent to Open Notebook as text sources.
# In Docker, use the container name if both share a network, e.g. http://open-notebook:5055
# OPEN_NOTEBOOK_URL=http://localhost:5055
# Only needed if Open Notebook has a password set (OPEN_NOTEBOOK_PASSWORD there)
# OPEN_NOTEBOOK_PASSWORD=
